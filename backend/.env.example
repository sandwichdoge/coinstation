# Copy to .env and fill in. All values have sane defaults except OPENAI_API_KEY.

# --- AI (optional) ---
# Without a key the app falls back to a transparent rule-based analysis.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: point at an OpenAI-compatible endpoint (Azure/proxy/local). Leave blank for OpenAI.
OPENAI_BASE_URL=

# --- Market data ---
BINANCE_BASE_URL=https://api.binance.com

# --- Database ---
# SQLite by default; swap for postgresql+psycopg://user:pass@host/db in production.
DATABASE_URL=sqlite:///./coinstation.db

# --- News (comma-separated RSS feed URLs) ---
RSS_FEEDS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss,https://decrypt.co/feed,https://bitcoinmagazine.com/feed

# --- CORS (comma-separated origins allowed to call the API) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
